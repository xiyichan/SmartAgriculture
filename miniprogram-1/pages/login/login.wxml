<!--pages/login/login.wxml-->
<view class="contain">
  <view class="inut-label">
    <label>账号</label>
    <input name="input" placeholder="请输入邮箱/电话号码" bindinput="Account"></input>
  </view>
  <view class="inut-label">
    <label>密码</label>
    <input name="input" placeholder="请输入密码" bindinput="Password" password="true"></input>
  </view>
  <view>
    <button type="primary" bindtap="login" style="width:90%;margin-left:5px">登录</button>
  </view>
  <view style="display:flex;margin-top:20px;margin-left:5px">
    <button bindtap="register">注册账号</button>
    <button bindtap="forgetPassword">忘记密码</button>
  </view>
</view>