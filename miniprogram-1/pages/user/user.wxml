<!--pages/user/user.wxml-->
<view class='head_img' bindtap='upShopLogo'>
  <view class='img' style="margin-left:10px;">
    <image style="width: 100px; height: 80px;" src="{{userimg}}"></image>
  </view>
</view>

<view class="my-text">
  <text style="display:block;margin:0 10px 10px" class="text-property showWindows" bindtap="showNameWindows">名字：{{user.Name}}</text>
  <text style="display:block;margin:0 10px 10px" class="text-property">邮箱：{{user.Email}}</text>
  <text style="display:block;margin:0 10px 10px" class="text-property">电话：{{user.Phone}}</text>
</view>

<view>
  <button bindtap="updatePassword" bindtap="showPasswordWindows">更新密码</button>
</view>