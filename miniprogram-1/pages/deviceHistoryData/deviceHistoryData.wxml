<!-- 引入wxs文件 -->
<wxs src="../../wxs/wxs.wxs" module="module1" />
<view class="tui-picker-content" style="display:flex;margin-left:10px">
  <!-- <view class="tui-picker-name">日期选择器（选择年月日）</view> -->
  <picker mode="date" value="{{date}}" bindchange="changeDate">
    <button size="mini">
      选择日期
    </button>
  </picker>
  <text style="display:block;margin-top:5px;margin-left:10px">{{date}}</text>
</view>

