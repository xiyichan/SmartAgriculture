<view>
  <scroll-view scroll-y="true" style="height:90vh;" class="box-scroll">
    <block wx:for="{{list}}" wx:key="index">
      <view class="text-view">
        <view class="text-label">
          <text style="margin-right:20px">时间：{{module1.time_format(item.Time)}} </text>
          <text>温度：{{item.Temperature}}</text>
        </view>
        <view class="text-label">
          <text style="margin-right:10px">湿度：{{item.Humidity}}</text>
          <text style="margin-right:10px">土壤湿度：{{item.SoilMoisture}}</text>
          <text>光照强度：{{item.LightIntensity}}</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>

<view class="section page">
  <picker bindchange="bindPickerChange" value="{{index}}" range="{{array}}">
  <button size="mini">选择页数</button>
  </picker>
  <text style="display:block;margin-bottom:3px;margin-left:10px">当前页数：{{array[index]}}</text>
</view>