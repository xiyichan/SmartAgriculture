<!--pages/forgetPassword/forgetPassword.wxml-->
<view>
  <view class="label-text">
    <label>邮箱</label>
  <input name="input" placeholder="请输入邮箱" bindinput="Email"></input>
  </view>
  <view class="label-text">
  <input style="margin-left:10px;margin-top:5px;width:60%;" name="input" placeholder="请输入验证码" bindinput="Captcha"></input>
  <button bindtap="getCaptcha" size="mini" type="primary">获取验证码</button>
  </view>
<view class="label-text">
  <label>密码</label>
  <input name="input" placeholder="请输入密码" bindinput="Password" password="true"></input>
</view>
<view style="margin-left:10px;">

  <input name="input" placeholder="请重复输入密码" bindinput="RePassword" password="true" style="width:90%;"></input>
</view>
  <button bindtap="updatePassword" style="margin-top:20px">修改密码</button>
</view>