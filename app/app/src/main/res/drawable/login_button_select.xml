<?xml version="1.0" encoding="utf-8"?>
<selector
	xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_pressed="true">
		<shape android:shape="rectangle">
			<solid android:color="#25A3C4" />
			<padding
				android:left="1dp"
				android:right="1dp"
				android:top="3dp"
				android:bottom="3dp" />
			<corners android:radius="5dp" />
			<stroke android:width="1px" android:color="#25A3C4" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<solid android:color="#2DC0E6" />
			<padding
				android:left="1dp"
				android:right="1dp"
				android:top="3dp"
				android:bottom="3dp" />
			<corners android:radius="5dp" />
			<stroke android:width="1px" android:color="#2DC0E6" />
		</shape>
	</item>
</selector>



