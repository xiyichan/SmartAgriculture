<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#AFB1B3" />
            <padding
                android:left="1dp"
                android:right="1dp"
                android:top="3dp"
                android:bottom="3dp" />
            <corners android:radius="5dp" />
            <stroke android:width="1px" android:color="#AFB1B3" />
        </shape>
    </item>
</selector>
